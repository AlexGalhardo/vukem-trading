APP_NAME=vukem-trading
APP_ENV=development
APP_KEY=
# Former APP_KEY values, comma-separated: they still decrypt after a rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
HOST=0.0.0.0
PORT=3000
APP_URL=http://localhost:3000
DATABASE_URL=postgres://scooby:scooby@localhost:5432/scooby?sslmode=disable


# Google-only sign in. Use a Google Web OAuth client, not a service account.
# Placeholder OWNER_GOOGLE_EMAIL: owner@example.invalid
# Placeholder SOCIAL_GOOGLE_CLIENT_ID: REPLACE_ME_GOOGLE_CLIENT_ID
# Placeholder SOCIAL_GOOGLE_CLIENT_SECRET: REPLACE_ME_GOOGLE_CLIENT_SECRET
# Keep optional credentials empty until real values are available.
OWNER_GOOGLE_EMAIL=
SOCIAL_GOOGLE_CLIENT_ID=
SOCIAL_GOOGLE_CLIENT_SECRET=
SESSION_DRIVER=database
CACHE_STORE=database
MAIL_MAILER=log

# Alpaca PAPER credentials. Live hosts cannot be configured.
# Placeholders: REPLACE_ME_ALPACA_PAPER_KEY / REPLACE_ME_ALPACA_PAPER_SECRET
ALPACA_API_KEY=
ALPACA_API_SECRET=

# Daily ranking (docs/sdd/07-daily-ranking-and-paper-runner.md). The job reuses the Alpaca key above for US
# daily bars and the Telegram variables below to send the ranking; without Telegram variables sending is off.
# Paper order placement (reco:paper) is off unless PAPER_TRADING=true. Binance testnet keys come from
# https://testnet.binance.vision; live hosts cannot be configured.
PAPER_TRADING=
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=

# Optional outbound operational alerts (never expose these to Vite).
# Placeholders: REPLACE_ME_TELEGRAM_BOT_TOKEN / REPLACE_ME_TELEGRAM_CHAT_ID
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Set to 3001 when running the engine beside the web process on one machine.
ENGINE_HEALTH_PORT=3001
# Read-only MCP endpoint (docs/mcp.md). Leave empty to keep it off; set a long random value to turn it on.
MCP_TOKEN=

# Live trading is off. A future live adapter in the worker reads these; see ADR-0021. Leave empty.
LIVE_TRADING_ENABLED=
LIVE_TRADING_ACK=
LIVE_MAX_ORDER_VALUE=
LIVE_MAX_DAILY_LOSS_BPS=
